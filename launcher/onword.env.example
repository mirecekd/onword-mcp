# onword-mcp launcher configuration
#
# Copy this file to "onword.env" next to onword-launch.ps1 (or to
# %LOCALAPPDATA%\onword-mcp\onword.env) and fill in your own values.
# onword.env is gitignored - it is the place for host names and anything
# else that must not end up in the repository.
#
# Syntax: KEY=VALUE per line, # for comments, quotes optional.
# Precedence: command-line parameter > environment variable > this file > default.

# SSH host for the reverse tunnel. Use a Host alias from ~/.ssh/config if you
# need a non-default user, port or identity file.
# Leave empty (or set ONWORD_NO_TUNNEL=1) to run without a tunnel.
ONWORD_SSH_TARGET=dev.domain.com

# Local port the MCP server listens on.
ONWORD_PORT=18347

# Port to bind on the remote side of the tunnel. Empty = same as ONWORD_PORT.
#ONWORD_REMOTE_PORT=

# What uvx builds the server from: a git URL, a local directory or a PyPI name.
#ONWORD_SOURCE=git+https://github.com/mirecekd/onword-mcp

# Set to 1 to never start the SSH tunnel.
#ONWORD_NO_TUNNEL=0
